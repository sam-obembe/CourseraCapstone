      <ProjectReference Include="..\Capstone.Common\Capstone.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="collectorApi\appsettings.Development.json" />
      <_ContentIncludedByDefault Remove="collectorApi\appsettings.json" />
    </ItemGroup>

